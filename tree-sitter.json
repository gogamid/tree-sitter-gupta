{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "gupta",
      "camelcase": "Gupta",
      "title": "Gupta",
      "scope": "source.gupta",
      "file-types": ["apt.indented", "apt"],
      "injection-regex": "^gupta$",
      "class-name": "TreeSitterGupta",
      "highlights": "queries/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Parser for Gupta or Team Developer or SQLWindows language",
    "authors": [
      {
        "name": "Imron Gamidli"
      }
    ],
    "links": {
      "repository": "https://github.com/gogamid/tree-sitter-gupta"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
